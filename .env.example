# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:5000"

# ============================================================================
# SUPABASE POSTGRESQL DATABASE CONFIGURATION (Required for Production Database)
# ============================================================================
SUPABASE_URL="https://your-project-ref.supabase.co"
# Service role key (Secret) - Used strictly server-side, never exposed to browser
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# Frontend / Public keys - prefix with VITE_
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# ============================================================================
# GARUDA FARMS ADMIN & AUTH CONFIGURATION
# ============================================================================
ADMIN_EMAIL="admin@garudafarms.com"
JWT_SECRET="your_custom_jwt_secret_here"

# ============================================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================================
RAZORPAY_KEY_ID="rzp_live_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Frontend Razorpay key (KEY_ID only — never expose SECRET to client)
VITE_RAZORPAY_KEY_ID="rzp_live_your_key_id_here"


