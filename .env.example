# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE POSTGRESQL DATABASE CONFIGURATION (Required for Production Database)
# ============================================================================
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
# Service role key (Secret) - Used strictly server-side, never exposed to browser
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ============================================================================
# GARUDA FARMS SINGLE ADMIN CREDENTIALS & AUTH
# ============================================================================
# Exactly ONE admin account has full access to the store
ADMIN_EMAIL="admin@garudafarms.com"
ADMIN_PASSWORD="GarudaAdmin@2026!"
JWT_SECRET="garuda-farms-production-jwt-secret-key-2026"

# ============================================================================
# RAZORPAY PAYMENT GATEWAY (Disabled until real credentials are provided)
# ============================================================================
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

