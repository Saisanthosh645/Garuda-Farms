# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================================
# SUPABASE POSTGRESQL DATABASE CONFIGURATION (Required for Production Database)
# ============================================================================
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
# Service role key (Secret) - Used strictly server-side, never exposed to browser
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVjbXdkZmJsdW9ybGVzcnN0Z2hyIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODUwMDAzNSwiZXhwIjoyMTA0MDc2MDM1fQ.BBAG1Eg3jakCyw2Hv-4rzj6z8fjxGVk_eexekq3OLfg"

# Vite / Frontend (public) keys - prefix with VITE_
# These are safe to expose to the browser (public anon key)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-from-supabase"

# ============================================================================
# GARUDA FARMS SINGLE ADMIN CREDENTIALS & AUTH
# ============================================================================
# Exactly ONE admin account has full access to the store
ADMIN_EMAIL="admin@garudafarms.com"

# ============================================================================
# RAZORPAY PAYMENT GATEWAY
# ============================================================================
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"

# Frontend Razorpay key (KEY_ID only — never expose SECRET to client)
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

